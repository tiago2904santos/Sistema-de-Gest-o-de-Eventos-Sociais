          "cv": {
            "css": "--foco"
          }
        }
      },
      "focus-ring": {
        "$value": "{color.gold.700}",
        "$description": "PROPOSTA: anel de foco com contraste ≥ 3:1 contra papel e branco.",
        "$extensions": {
          "cv": {
            "status": "proposed"
          }
        }
      },
      "text": {
        "$value": "{color.neutral.700}",
        "$extensions": {
          "cv": {
            "css": "body color"
          }
        }
      },
      "text-strong": {
        "$value": "{color.neutral.900}"
      },
      "text-muted": {
        "$value": "{color.neutral.600}",
        "$description": "PROPOSTA: substitui n-400/n-450 em texto pequeno (contraste ≥ 4,5:1).",
        "$extensions": {
          "cv": {
            "status": "proposed"
          }
        }
      },
      "label": {
        "$value": "{color.neutral.450}",
        "$description": "Atual: 4,33:1 sobre papel em 11px — abaixo do AA.",
        "$extensions": {
          "cv": {
            "css": "--rotulo",
            "status": "needs-fix"
          }
        }
      },
      "hover-bg": {
        "$value": "{color.neutral.100}",
        "$extensions": {
