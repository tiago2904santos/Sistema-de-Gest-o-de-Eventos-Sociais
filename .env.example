# Copie este arquivo para `.env` e ajuste os valores.

# Segurança
DJANGO_SECRET_KEY=troque-por-uma-chave-secreta-forte
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL — quando POSTGRES_DB estiver definido, o projeto usa PostgreSQL.
# Sem essas variáveis, usa SQLite como fallback de desenvolvimento.
POSTGRES_DB=eventos_sociais
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# E-mail (opcional) — sem EMAIL_HOST, as notificações por e-mail vão para o
# console (modo desenvolvimento). Configure para habilitar SMTP real.
#
# Gmail: use uma "senha de app" (myaccount.google.com/apppasswords, exige
# verificação em duas etapas) — nunca a senha normal da conta.
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=seuemail@gmail.com
# EMAIL_HOST_PASSWORD=senha-de-app-de-16-letras
# EMAIL_USE_TLS=1
# DEFAULT_FROM_EMAIL=seuemail@gmail.com
#
# Servidor institucional (quando disponível):
# EMAIL_HOST=smtp.pc.pr.gov.br
# EMAIL_PORT=587
# EMAIL_HOST_USER=eventos-sociais@pc.pr.gov.br
# EMAIL_HOST_PASSWORD=
# EMAIL_USE_TLS=1            # porta 587; para porta 465 use EMAIL_USE_SSL=1
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=eventos-sociais@pc.pr.gov.br
